              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">int count = Integer.parseInt(vars.get(&quot;categoryHref_matchNr&quot;))
int randomIndex = 1 + new Random().nextInt(count)

String category = vars.get(&quot;categoryHref_&quot; + randomIndex)
category = category.replaceFirst(&quot;^.*?/en/&quot;, &quot;&quot;)

vars.put(&quot;selectedCategory&quot;, category)

log.info(&quot;Selected category: &quot; + category)</stringProp>
            </JSR223PreProcessor>
