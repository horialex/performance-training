      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler - Search terms script">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def searchList = [
    &quot;jeans&quot;,
    &quot;shirt&quot;,
    &quot;laptop&quot;,
    &quot;sweater&quot;,
    &quot;shoes&quot;,
    &quot;notebook&quot;,
    &quot;samsung&quot;,
    &quot;vector&quot;,
    &quot;hummingbird&quot;,
    &quot;mountain&quot;
]
def searchString =
    searchList[new Random().nextInt(searchList.size())]

vars.put(&quot;searchString&quot;, searchString)

log.info(&quot;Selected search term: &quot; + searchString)

vars.put(
    &quot;search3&quot;,
    searchString.substring(0, Math.min(3, searchString.length()))
)

vars.put(
    &quot;search4&quot;,
    searchString.substring(0, Math.min(4, searchString.length()))
)

vars.put(
    &quot;searchFull&quot;,
    searchString
)</stringProp>
        </JSR223Sampler>
