            <stringProp name="script">def searchList = [
    &quot;bluetooth&quot;, 
    &quot;mug&quot;, 
    &quot;notebook&quot;, 
    &quot;sweater&quot;,
    &quot;poster&quot;
]

def searchString = searchList[new Random().nextInt(searchList.size())]
vars.put(&quot;searchString&quot;, searchString)</stringProp>
