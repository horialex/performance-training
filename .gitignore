# ---------------------------------------------------------------
# JMeter raw results
# ---------------------------------------------------------------
# Regenerated by every run and large (a 20-iteration baseline with
# subresults on is ~52 MB / 290k rows). The exported aggregate_*.csv /
# summary_*.csv tables and the *_metadata_*.txt notes stay tracked.
*.jtl

# HTML dashboards produced by `jmeter -g`
*_html/
report/

# ---------------------------------------------------------------
# JMeter runtime output
# ---------------------------------------------------------------
*.log
scripts/temp/

# GUI save backups
*.jmx.bak
